{
  "name": "markdown-a4-renderer",
  "description": "React component that renders Markdown as a fixed-width A4 sheet with an infinitely growing height (no pagination).",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/markdown-a4-renderer.cjs.js",
  "module": "./dist/markdown-a4-renderer.es.js",
  "exports": {
    ".": {
      "import": "./dist/markdown-a4-renderer.es.js",
      "require": "./dist/markdown-a4-renderer.cjs.js"
    },
    "./style.css": "./dist/markdown-a4-renderer.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.3.0"
  }
}
